# Copy this file to .env (local) or .env.production (server) and fill in real values.
# Never commit real values. Never paste real keys into chat or tickets.

# Field encryption (Phase 2)
# One or more Fernet keys, comma-separated, NEWEST FIRST.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# Separate secret for blind-index fingerprints (at least 32 characters, different from every key above).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BLIND_INDEX_KEY=
